rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Helper Primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection doc read rule
    match /test/connection {
      allow read: if true;
    }

    // Helper: Validate Project Comment shape
    function isValidComment(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.body is string && data.body.size() >= 3 && data.body.size() <= 1000 &&
             (!('parentId' in data) || data.parentId == null || (data.parentId is string && data.parentId.size() <= 128)) &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is timestamp;
    }

    // Helper: Validate Project Idea shape
    function isValidIdea(data) {
      return data.projectId is string && data.projectId.size() <= 128 &&
             data.userId is string && data.userId.size() <= 128 && data.userId == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 120 &&
             (!('photoURL' in data) || data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             data.title is string && data.title.size() >= 5 && data.title.size() <= 120 &&
             data.body is string && data.body.size() >= 10 && data.body.size() <= 2000 &&
             data.status in ['pending', 'approved', 'rejected'] &&
             data.createdAt is timestamp;
    }

    // Helper: Validate Comment Report shape
    function isValidReport(data) {
      return data.commentId is string && data.commentId.size() <= 128 &&
             data.reporterId is string && data.reporterId.size() <= 128 && data.reporterId == request.auth.uid &&
             data.reason is string && data.reason.size() >= 5 && data.reason.size() <= 500 &&
             data.createdAt is timestamp;
    }

    // 1. Project Comments Collection
    match /projectComments/{commentId} {
      allow get: if resource.data.status == 'approved' ||
                    (isSignedIn() && resource.data.userId == request.auth.uid);

      allow list: if (resource.data.status == 'approved') ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(commentId) &&
                       isValidComment(request.resource.data) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdAt == request.time;

      allow update: if isSignedIn() &&
                       isOwner(resource.data.userId) &&
                       isValidComment(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.projectId == resource.data.projectId &&
                       request.resource.data.status == resource.data.status &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.updatedAt == request.time &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['body', 'updatedAt']);

      allow delete: if isOwner(resource.data.userId);
    }

    // 2. Project Ideas & Suggestions Collection
    match /projectIdeas/{ideaId} {
      allow get: if resource.data.status == 'approved' ||
                    (isSignedIn() && resource.data.userId == request.auth.uid);

      allow list: if (resource.data.status == 'approved') ||
                     (isSignedIn() && resource.data.userId == request.auth.uid);

      allow create: if isSignedIn() &&
                       isValidId(ideaId) &&
                       isValidIdea(request.resource.data) &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.createdAt == request.time;

      allow update: if isSignedIn() &&
                       isOwner(resource.data.userId) &&
                       isValidIdea(request.resource.data) &&
                       request.resource.data.userId == resource.data.userId &&
                       request.resource.data.projectId == resource.data.projectId &&
                       request.resource.data.status == resource.data.status &&
                       request.resource.data.createdAt == resource.data.createdAt &&
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'body']);

      allow delete: if isOwner(resource.data.userId);
    }

    // 3. Comment Reports Collection
    match /commentReports/{reportId} {
      allow get, list: if false;

      allow create: if isSignedIn() &&
                       isValidId(reportId) &&
                       isValidReport(request.resource.data) &&
                       request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }
  }
}
