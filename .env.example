# ==========================================
# GIZMO ENGINEERING SHOWCASE - ENVIRONMENT
# ==========================================

# Base URL for GitHub Pages or custom domain hosting
# For https://USERNAME.github.io/REPOSITORY/, set to /REPOSITORY/
VITE_BASE_PATH="/"

# Firebase Web Client Configuration (Optional for public browsing, required for cloud auth & comments)
# Obtain these from your Firebase Console > Project Settings > General > Your apps (Web)
VITE_FIREBASE_API_KEY="AIzaSyExampleKey"
VITE_FIREBASE_AUTH_DOMAIN="your-app.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-app"
VITE_FIREBASE_STORAGE_BUCKET="your-app.appspot.com"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef123456"

# Server runtime variables (AI Studio development environment)
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
